# Copy to .env.local and point this at wherever task-manager-api is
# actually running. .env.local is gitignored by the Vite template.
#
# Note: on macOS, port 5000 is often taken by Control Center's AirPlay
# Receiver, so task-manager-api's README suggests PORT=5050 instead —
# match whatever you actually started the backend on.
VITE_API_BASE_URL=http://localhost:5050
